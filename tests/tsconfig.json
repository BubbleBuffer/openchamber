{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest"],
    "allowJs": false,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../packages/web/src/ui/*"],
      "@openchamber/session-state": ["../packages/session-state/src/index.ts"],
      "@openchamber/web": ["../packages/web/server/src/index.ts"],
      "@tanstack/react-virtual": ["./react/mocks/tanstack-react-virtual.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../packages/web/server/src/types/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
