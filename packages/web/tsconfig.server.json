{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "server/dist",
    "rootDir": "server/src",
    "baseUrl": ".",
    "types": ["node"]
  },
  "include": ["server/src"],
  "exclude": ["server/dist", "server/lib"]
}