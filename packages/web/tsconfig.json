{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["vite/client", "@types/dom-speech-recognition", "node", "bun"],
    "paths": {
      "@/*": ["./src/ui/*"],
      "@web/*": ["./src/*"],
      "@openchamber/web/*": ["./src/*"],
      "@contracts/*": ["./server/src/contracts/*"],
      "@openchamber/session-state": ["../session-state/src/index.ts"]
    }
  },
  "include": ["src"]
}
