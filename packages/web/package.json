{
  "name": "@openchamber/web",
  "version": "1.9.11",
  "private": false,
  "type": "module",
  "main": "./server/dist/index.js",
  "types": "./server/dist/index.d.ts",
  "bin": {
    "openchamber": "./bin/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run build:watch",
    "build:session-state": "bun run --cwd ../session-state build",
    "dev:server": "bun run build:session-state && bun server/src/main.ts --port ${OPENCHAMBER_PORT:-3001}",
    "dev:server:watch": "bun run build:session-state && bun --watch server/src/main.ts --port ${OPENCHAMBER_PORT:-3001}",
    "build": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:watch": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --watch",
    "type-check": "tsc --noEmit",
    "type-check:server": "tsc --noEmit -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.build.json",
    "dev:server:ts": "bun run build:session-state && bun server/src/main.ts --port ${OPENCHAMBER_PORT:-3001}",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" \"./server/src/**/*.ts\" --config ../../eslint.config.js",
    "test": "vitest run",
    "test:stores": "bun test --isolate src/ui/stores",
    "start": "node bin/cli.js serve",
    "pack": "npm pack --workspaces=false"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@octokit/rest": "^22.0.1",
    "@opencode-ai/sdk": "^1.14.39",
