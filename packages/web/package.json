    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@remixicon/react": "^4.9.0",
    "@sentry/vite-plugin": "^5.2.1",
    "@simplewebauthn/browser": "13.3.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
