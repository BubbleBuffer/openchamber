{
  "name": "@openchamber/session-state",
  "version": "1.9.11",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pack": "npm pack --workspaces=false",
    "type-check": "tsc --noEmit",
    "test": "bun test ./src/**/*.test.ts",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" --config ../../eslint.config.js"
  },
  "dependencies": {
    "xstate": "^5.19.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "~5.8.3"
  }
}
